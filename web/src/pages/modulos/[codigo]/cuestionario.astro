---
import Base from "../../../layouts/Base.astro";
import { modulosDisponibles } from "../../../data/catalogo";
import { material } from "../../../data/modulos-md";
import { leerFuente } from "../../../data/modulos-md";
import { parseCuestionario } from "../../../data/cuestionario";

export function getStaticPaths() {
  return modulosDisponibles()
    .filter((m) => material(m.carpeta!).cuestionarioHtml)
    .map((m) => ({ params: { codigo: m.codigo.toLowerCase() }, props: { m } }));
}

const { m } = Astro.props;
const mat = material(m.carpeta!);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Si el formato no se entiende, parseCuestionario devuelve null y se muestra el Markdown como antes.
const quiz = parseCuestionario(leerFuente(m.carpeta!, "cuestionario.md") ?? "");
const letras = "abcde";
const config = quiz ? { clave: `cuestionario:${m.codigo}`, correctas: quiz.map((q) => q.correcta) } : null;
---
<Base titulo={`Cuestionario · ${m.codigo}`} descripcion={`Cuestionario del módulo ${m.codigo}`}>
  <div class="wrap">
    <p><a href={`${base}/modulos/${m.codigo.toLowerCase()}/`}>← {m.titulo}</a></p>
    <h1>Cuestionario · {m.codigo}</h1>
    {quiz ? (
      <>
        <script type="application/json" id="cq-config" set:html={JSON.stringify(config).replace(/</g, "\\u003c")} />
        <div class="cq-resumen">
          <span data-cq-resumen></span>
          <button class="ej-btn" type="button" data-cq-reintentar hidden>Volver a empezar</button>
        </div>
        {quiz.map((q, i) => (
          <section class="cq" data-cq>
            <div class="cq-enunciado"><span>{q.n}.</span> <div set:html={q.enunciadoHtml} /></div>
            <ul class="cq-opciones">
              {q.opcionesHtml.map((o, j) => (
                <li><button type="button" class="cq-op"><span class="letra">{letras[j]})</span><span set:html={o} /></button></li>
              ))}
            </ul>
            <div class="cq-expl" hidden>
              <strong data-cq-veredicto></strong>
              {q.porQueHtml && <span set:html={q.porQueHtml} />}
            </div>
          </section>
        ))}
        <script>
          import { iniciarCuestionario } from "../../../scripts/motor-cuestionario";
          iniciarCuestionario();
        </script>
      </>
    ) : (
      <div class="prose" set:html={mat.cuestionarioHtml} />
    )}
  </div>
</Base>
