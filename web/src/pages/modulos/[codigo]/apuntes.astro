---
import Base from "../../../layouts/Base.astro";
import { modulosDisponibles } from "../../../data/catalogo";
import { material } from "../../../data/modulos-md";
import { colabUrl, REPO_URL, REPO_RAMA } from "../../../config";
import { existsSync } from "node:fs";
import path from "node:path";

export function getStaticPaths() {
  return modulosDisponibles().map((m) => ({
    params: { codigo: m.codigo.toLowerCase() },
    props: { m },
  }));
}

const { m } = Astro.props;
const mat = material(m.carpeta!);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const colab = colabUrl(m.carpeta!); // repositorio configurado en src/config.ts
// Algunos módulos (p. ej. FS1, en TypeScript) no tienen notebook: enlazamos su carpeta en GitHub.
const tieneNotebook = existsSync(path.resolve(process.cwd(), "../modulos", m.carpeta!, "notebook.ipynb"));
const carpetaGithub = `${REPO_URL}/tree/${REPO_RAMA}/modulos/${m.carpeta}`;
---
<Base titulo={`Apuntes · ${m.codigo}`} descripcion={`Apuntes del módulo ${m.codigo}`}>
  <div class="wrap">
    <p><a href={`${base}/modulos/${m.codigo.toLowerCase()}/`}>← {m.titulo}</a></p>
    <h1>Apuntes · {m.codigo} {m.titulo}</h1>
    {tieneNotebook
      ? <p style="color:var(--texto-suave)">💻 Práctica: abre el notebook en <a href={colab} target="_blank" rel="noopener">Google Colab</a> o clona el repositorio y ejecútalo con Jupyter.</p>
      : <p style="color:var(--texto-suave)">💻 Práctica: el proyecto está en <a href={carpetaGithub} target="_blank" rel="noopener">la carpeta del módulo en GitHub</a>; sigue las instrucciones de su README.</p>}
    <div class="prose" set:html={mat.apuntesHtml} />
  </div>
</Base>
